# Database Configuration (MongoDB Atlas)
# Get connection string from MongoDB Atlas: mongodb+srv://<user>:<pass>@cluster.mongodb.net/homeglazer?retryWrites=true&w=majority
# REQUIRED for Amplify production - set in Amplify Console → Environment variables
DATABASE_URL="mongodb+srv://user:password@cluster.mongodb.net/homeglazer?retryWrites=true&w=majority"

# Migration: PostgreSQL to MongoDB (npm run db:migrate-to-mongo)
# SOURCE_DATABASE_URL = PostgreSQL source (Vercel Postgres, RDS, etc.)
# DATABASE_URL = MongoDB target (above)
# SOURCE_DATABASE_URL="postgresql://user:pass@host:5432/db?sslmode=require"

# JWT Secret for authentication
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your-secret-key-change-in-production"

# Prisma seed creates the first admin if missing (local/CI: npx prisma db seed).
# Optional overrides; defaults are admin@homeglazer.com / admin123.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# AWS S3 (for media uploads - use S3_ prefix; Amplify blocks AWS_* vars)
S3_BUCKET="homeglazer-prod-media-ACCOUNT_ID"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="your-access-key-id"
S3_SECRET_ACCESS_KEY="your-secret-access-key"

# Gmail (for visualiser summary emails)
GMAIL_USER="your-email@gmail.com"
GMAIL_APP_PASSWORD="your-app-password"

# Site URL (set to Amplify app URL after deploy)
NEXT_PUBLIC_SITE_URL="https://your-app.amplifyapp.com"

# S3 media base URL (for images removed by Amplify postBuild - uploads, media, room images)
# Set in Amplify Console. Example: https://homeglazer-prod-media-363341493807.s3.us-east-1.amazonaws.com
NEXT_PUBLIC_S3_MEDIA_URL=""

# Blog AI — OpenAI-compatible chat API (Moonshot Kimi OR NVIDIA NIM)
# Prod: set NVIDIA_API_KEY (nvapi-...) and KIMI_API_BASE, OR MOONSHOT_API_KEY + Moonshot base URL.
# Local: `.env.local` — see `.env.local.example`.
# NVIDIA_API_KEY=""
# KIMI_API_BASE=https://integrate.api.nvidia.com/v1
# KIMI_MODEL=moonshotai/kimi-k2.6
# KIMI_FALLBACK_MODELS=meta/llama-3.1-70b-instruct,meta/llama-3.1-8b-instruct
# Alternative (Moonshot direct): MOONSHOT_API_KEY="", KIMI_API_BASE=https://api.moonshot.ai/v1, KIMI_MODEL=kimi-k2.6
# BLOG_AI_DEFAULT_AUTHOR=Home Glazer
