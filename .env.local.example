# Local Development Environment Variables
# Copy this file to .env.local for local overrides (don't commit .env.local)

# INTEGRATION TESTING: Uncomment to test against production API
# NEXT_PUBLIC_API_URL="https://main.d15nk5b2guin5u.amplifyapp.com"

# LOCAL DEVELOPMENT: These are automatically set from .env
# NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Blog AI (OpenAI-compatible Chat Completions) ──
#
# Option A — NVIDIA NIM (`nvapi-...` keys from https://build.nvidia.com/)
#   Omit the literal "Bearer " prefix in the env value.
#
# NVIDIA_API_KEY=nvapi-your-key-here
# KIMI_API_BASE=https://integrate.api.nvidia.com/v1
# KIMI_MODEL=moonshotai/kimi-k2.6
# KIMI_FALLBACK_MODELS=meta/llama-3.1-70b-instruct,meta/llama-3.1-8b-instruct
#
# Option B — Moonshot Kimi direct (https://platform.kimi.ai/)
#
# MOONSHOT_API_KEY=sk-your-key-here
# KIMI_API_BASE=https://api.moonshot.ai/v1   # mainland China sometimes: https://api.moonshot.cn/v1
# KIMI_MODEL=kimi-k2.6
#
# BLOG_AI_DEFAULT_AUTHOR=Home Glazer
# BLOG_AI_COVER_PLACEHOLDER=/uploads/living-room.svg
