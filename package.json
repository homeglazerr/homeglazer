{
  "version": "1.0.0",
  "name": "anima-project",
  "description": "A React project automatically generated by Anima using the Shadcn UI library",
  "scripts": {
    "dev": "next dev",
    "postinstall": "prisma generate",
    "prebuild": "tsx scripts/generate-wall-masks.ts",
    "build": "bash scripts/build.sh",
    "postbuild": "node scripts/generate-sitemap-colour-visualiser.js && node scripts/generate-sitemap-products-asian-paints.js && next-sitemap && node scripts/validate-sitemaps.js",
    "vercel-build": "bash scripts/build.sh",
    "start": "next start",
    "obfuscate:backup": "node scripts/obfuscate.js backup",
    "obfuscate:process": "node scripts/obfuscate.js obfuscate",
    "obfuscate:restore": "node scripts/obfuscate.js restore",
    "obfuscate:deploy": "node scripts/obfuscate.js deploy",
    "build:secure": "npm run obfuscate:deploy && npm run build && npm run obfuscate:restore",
    "db:seed": "npx prisma db seed",
    "db:create-admin": "tsx scripts/create-admin.ts",
    "db:migrate-prices": "npx tsx scripts/migrate-prices-to-available-sizes.ts",
    "db:migrate-categories": "npx tsx scripts/migrate-categories.ts",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate && node scripts/create-default-js.js && node scripts/compile-prisma-client.js",
    "db:studio": "prisma studio",
    "db:migrate-to-mongo": "tsx scripts/migrate-postgres-to-mongodb.ts",
    "generate:jwt-secret": "node scripts/generate-jwt-secret.js",
    "upload:visualiser": "tsx scripts/upload-visualiser-to-s3.ts",
    "upload:visualiser-thumbnails": "tsx scripts/upload-visualiser-thumbnails-to-s3.ts",
    "upload:media": "tsx scripts/upload-media-to-s3.ts",
    "generate:wp-redirects": "node scripts/generate-wp-redirects.js --write",
    "generate:gsc-404-redirects": "python3 scripts/generate-gsc-404-redirects.py",
    "generate:colour-visualiser-urls": "node scripts/generate-colour-visualiser-urls.js",
    "generate:sitemap-colour-visualiser": "node scripts/generate-sitemap-colour-visualiser.js",
    "generate:sitemap-products-asian-paints": "node scripts/generate-sitemap-products-asian-paints.js"
  },
